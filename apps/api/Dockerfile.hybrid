# Optional Linux AMD64 extension of the ordinary API image. Build inputs are
# explicit artifact contexts; none of the workstation's credentials enter them.
ARG API_IMAGE=clip-api:local
FROM python:3.14.8-slim-trixie AS semantic-build
COPY --from=ghcr.io/astral-sh/uv:0.10.7 /uv /bin/uv

# Use the pinned self-contained CPython distribution, not the API interpreter.
COPY --from=semantic-python / /opt/semantic/python/
COPY --from=semantic-wheels / /wheels/
COPY scripts/evaluation/semantic/requirements-linux-x86_64.txt /tmp/helper.txt
RUN --network=none /opt/semantic/python/bin/python3.13 -c "import sys; assert sys.version_info[:3] == (3, 13, 12)" \
    && uv venv /opt/semantic/venv --python /opt/semantic/python/bin/python3.13 --no-python-downloads \
    && uv pip sync /tmp/helper.txt --python /opt/semantic/venv/bin/python --require-hashes --only-binary :all: --no-index --find-links /wheels --offline --link-mode copy

FROM ${API_IMAGE} AS runtime
COPY --from=semantic-build --chown=10001:10001 /opt/semantic /opt/semantic
COPY --from=semantic-model --chown=10001:10001 onnx/model.onnx /opt/semantic/model/onnx/model.onnx
COPY --from=semantic-model --chown=10001:10001 tokenizer.json /opt/semantic/model/tokenizer.json
COPY --chown=10001:10001 scripts/search_pipeline.py /app/scripts/search_pipeline.py

ENV CLIP_HYBRID_SEARCH_ENABLED=true \
    CLIP_HYBRID_WORKER_ENABLED=true \
    CLIP_HYBRID_SEARCH_INTERPRETER=/opt/semantic/venv/bin/python \
    CLIP_HYBRID_SEARCH_MODEL_DIR=/opt/semantic/model

# Verify the exact artifacts and execute real inference as the runtime user,
# without networking, database credentials or a synthetic model.
RUN --network=none python - <<'PY'
import asyncio
from pathlib import Path
import sys
sys.path.insert(0, '/app/apps/api')
from app.domains.listings.embedding_client import SemanticHelper

async def check():
    helper = SemanticHelper(Path('/opt/semantic/venv/bin/python'), Path('/opt/semantic/model'))
    try:
        await helper.start()
        result = await helper.encode_query('campus bicycle')
        assert len(result.vector) == 384
        print('Hybrid image: real offline inference passed (384 dimensions)')
    finally:
        await helper.close()

asyncio.run(check())
PY
