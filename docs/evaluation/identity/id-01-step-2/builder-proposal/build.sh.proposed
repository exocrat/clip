#!/bin/bash
# Reviewed proposal for execution only on the exact separately approved builder.
# Source arrives via operator SSM transfer; no registry push or email is performed.
set -euo pipefail
umask 077
[[ "$(uname -m)" == x86_64 ]]
systemctl is-active --quiet clip-id01-builder-expiry.timer
[[ "$(docker version --format '{{.Server.Arch}}')" == amd64 ]]
build_dir=/opt/clip-id01-build
image_tag=clip-api:id01-amd64-52186a0466fe
archive="$build_dir/source.tar.gz"
[[ -s "$archive" ]]
[[ "$(sha256sum "$archive" | cut -d ' ' -f 1)" == 34f1404bec5c4971ed022ed3e4ba4ba0d2599b8d12f7b05032913b76e855deb0 ]]
if docker image inspect "$image_tag" >/dev/null 2>&1; then
  printf '%s\n' 'Refusing an existing image tag'
  exit 1
fi
mkdir "$build_dir/context"
tar -xzf "$archive" -C "$build_dir/context" --no-same-owner
# Native build from the committed allowlisted context; no credentials build args.
timeout --kill-after=10s 1200 env DOCKER_BUILDKIT=0 docker build \
  --platform linux/amd64 --file "$build_dir/context/apps/api/Dockerfile" \
  --tag "$image_tag" "$build_dir/context"
docker run --rm --network none --entrypoint python "$image_tag" -c \
  'import os,platform,sys,boto3; import sys as s; s.path.insert(0,"/app/apps/api"); import app.domains.identity.email_smoke; assert platform.machine()=="x86_64"; assert os.getuid()==10001; assert sys.version_info[:2]==(3,14); print("runtime_import_uid_arch_passed")'
# A missing approval flag must stop before credentials or any provider request.
set +e
docker run --rm --network none --workdir /app/apps/api --entrypoint python \
  "$image_tag" -m app.domains.identity.email_smoke >"$build_dir/denied-output.txt" 2>&1
denied_status=$?
set -e
[[ "$denied_status" == 1 ]]
[[ "$(cat "$build_dir/denied-output.txt")" == '{"outcome": "failed_or_uncertain"}' ]]
# Normal liveness check runs with no network interfaces except loopback and no ports.
container_id=
cleanup() {
  if [[ -n "$container_id" ]]; then docker rm --force "$container_id" >/dev/null; fi
}
trap cleanup EXIT
container_id=$(docker run --detach --network none "$image_tag")
healthy=false
for attempt in $(seq 1 45); do
  if [[ "$(docker inspect --format '{{.State.Health.Status}}' "$container_id")" == healthy ]]; then
    healthy=true
    break
  fi
  sleep 1
done
[[ "$healthy" == true ]]
docker image inspect --format 'image_id={{.Id}} os={{.Os}} arch={{.Architecture}} user={{.Config.User}} size={{.Size}}' "$image_tag"
printf '%s\n' 'build_and_local_validation_passed; no image publication or email send'
