#!/bin/bash
# Execute only after approval of this exact built image and target tag.
# Token exists only in a private /run directory and is removed on exit.
set -euo pipefail
umask 077
registry=335523638354.dkr.ecr.ap-south-1.amazonaws.com
local_tag=clip-api:id01-amd64-52186a0466fe
target="$registry/clip-shared-test-api:id01-amd64-52186a0466fe"
[[ "$(docker image inspect --format '{{.Id}}' "$local_tag")" == sha256:e630678ecb23c3e027b55147a6be4741586e69d22521f1e8b536d212ba7de2c8 ]]
[[ "$(docker image inspect --format '{{.Architecture}}' "$local_tag")" == amd64 ]]
caller_arn=$(aws sts get-caller-identity --region ap-south-1 --query Arn --output text)
case "$caller_arn" in
  arn:aws:sts::335523638354:assumed-role/clip-test-id01-amd64-builder/*) ;;
  *) printf '%s\n' 'Unexpected builder role'; exit 1 ;;
esac
auth_dir=$(mktemp -d /run/clip-id01-ecr.XXXXXX)
cleanup() {
  docker --config "$auth_dir" logout "$registry" >/dev/null 2>&1 || true
  rm -f "$auth_dir/config.json"
  rmdir "$auth_dir"
}
trap cleanup EXIT
aws ecr get-login-password --region ap-south-1 | \
  docker --config "$auth_dir" login --username AWS --password-stdin "$registry" >/dev/null
docker tag "$local_tag" "$target"
timeout --kill-after=10s 600 docker --config "$auth_dir" push "$target"
printf '%s\n' 'exact_image_push_completed; registry_digest_verification_pending'
