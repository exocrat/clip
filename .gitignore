# Local environment files; keep the safe example tracked.
.env
.env.*
!.env.example

# Python and uv.
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Node and npm.
node_modules/
npm-debug.log*

# Build and test outputs.
build/
dist/
coverage/

# Regenerable PD-09 preview payloads only. Keep manifests, source and labels.
/data/runs/*/dataset.json

# Terraform working data, state, plans, variable inputs, and sensitive outputs.
.terraform/
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
*.plan
tfplan
plan.out
*.tfvars
*.tfvars.json
!*.tfvars.example
.aws/
credentials
credentials.*
*.pem
*.key
*.credentials
.terraformrc
terraform.rc
terraform-output*.json
*.sensitive
*.sensitive.*
infra/terraform/domains/listings/test/.demo-baseline.json
infra/terraform/domains/listings/test/.demo-baseline.tmp

# macOS Finder metadata.
.DS_Store
