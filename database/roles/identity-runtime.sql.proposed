-- ID-01 local proposal only. Never applied by migrations or default startup.
-- Exact database target, role creation/password, role logging defaults and grants
-- require their own reviewed shared/cloud plan. Set password privately via psql
-- \password after separately approved creation; never put it in SQL or Terraform.
-- Test harness creates this login only in its own disposable PostgreSQL.
-- Proposed login: clip_test_identity_app LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE
-- NOINHERIT NOREPLICATION NOBYPASSRLS CONNECTION LIMIT 10, no role memberships.
-- Global PUBLIC CONNECT/TEMP and schema CREATE baseline must be reviewed first;
-- do not revoke shared PUBLIC privileges as an implicit part of this proposal.
-- Grant explicit CONNECT on the approved database in its exact apply plan.

ALTER ROLE clip_test_identity_app SET log_statement = 'none';
ALTER ROLE clip_test_identity_app SET log_min_duration_statement = '-1';
ALTER ROLE clip_test_identity_app SET log_min_duration_sample = '-1';
ALTER ROLE clip_test_identity_app SET log_transaction_sample_rate = '0';
ALTER ROLE clip_test_identity_app SET log_min_error_statement = 'panic';
ALTER ROLE clip_test_identity_app SET log_parameter_max_length_on_error = '0';

GRANT USAGE ON SCHEMA identity, public TO clip_test_identity_app;
GRANT SELECT ON public.schema_migrations TO clip_test_identity_app;
GRANT SELECT, INSERT, UPDATE ON identity.users TO clip_test_identity_app;
GRANT SELECT, INSERT ON identity.external_identities TO clip_test_identity_app;
GRANT SELECT, INSERT ON identity.temporary_enrollments TO clip_test_identity_app;
GRANT SELECT, INSERT ON identity.otp_key_binding TO clip_test_identity_app;
GRANT SELECT, INSERT ON identity.otp_operations TO clip_test_identity_app;
GRANT SELECT, INSERT, UPDATE, DELETE ON
  identity.contacts, identity.temporary_credentials, identity.sessions,
  identity.otp_challenges, identity.otp_send_reservations,
  identity.otp_verification_windows, identity.password_login_windows,
  identity.auth_source_events, identity.microsoft_login_attempts
TO clip_test_identity_app;
-- No table ownership, DDL, TRUNCATE, REFERENCES, TRIGGER, MAINTAIN, future-table
-- default grants or other-domain data grants. Listings keeps its separate login.
