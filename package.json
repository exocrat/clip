{
  "name": "campus-marketplace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "npm": ">=11.0.0 <12.0.0"
  },
  "scripts": {
    "dev": "vite apps/web",
    "lint": "cd apps/web && biome lint src tests vite.config.ts vitest.config.ts",
    "typecheck": "tsc -p apps/web/tsconfig.json && tsc -p apps/web/tests/tsconfig.json",
    "test": "vitest run --config apps/web/vitest.config.ts",
    "build": "npm run typecheck && vite build apps/web",
    "check": "npm run lint && npm test && npm run build",
    "preview": "vite preview apps/web"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@hey-api/openapi-ts": "0.99.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@hey-api/json-schema-ref-parser": {
      "js-yaml": "4.3.2"
    }
  }
}
