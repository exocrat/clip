# Non-secret examples only. The API reads the process environment, not this file.
# Local example of a runtime setting: local, test, or production.
CLIP_ENVIRONMENT=local
# Local/runtime setting: default false; production rejects true.
CLIP_DEBUG=false

# Providers are unavailable until their implementing tasks configure them.
# Explicit local/test-only selection "fake" reserves a test adapter; no fake is
# wired into the API here. Production rejects fake providers and development auth.
# ID-01: "microsoft" selects private local/test validation preparation only.
# Production refuses it until login-attempt/session integration is reviewed;
# selecting it does not install a sign-in endpoint or a browser session.
CLIP_IDENTITY_PROVIDER=disabled
CLIP_EMAIL_PROVIDER=disabled
CLIP_STORAGE_PROVIDER=disabled
CLIP_DEVELOPMENT_AUTH=false
# Serve the bundled UI and /api routes in the same process. This does not select
# a synthetic caller; the integrated deployment still uses real Identity.
CLIP_SERVE_WEB_APP=false

# PD-08 local PostgreSQL only. Clearly fake example; never use for a shared,
# deployed or production database. Compose requires this process/environment
# variable; the API does not read this file or gain database wiring from it.
CLIP_LOCAL_POSTGRES_PASSWORD=FAKE_LOCAL_ONLY_clip_database_password

# ID-01 sandbox SES transport only; disabled above by default. No live send is
# authorized by these settings. Production currently refuses SES selection.
CLIP_SES_REGION=ap-south-1
CLIP_SES_SENDER=verify@clip-iisc.site
# JSON array of approved controlled recipients; never commit real addresses.
CLIP_SES_TEST_RECIPIENTS=[]

# ID-01 browser build setting (public, not an API credential). Disabled until
# reviewed runtime/provider enablement. Synthetic preview always keeps it off.
VITE_MICROSOFT_SIGN_IN_ENABLED=false


# SE-01 Hybrid read capability is disabled by default. These are process settings,
# not a deployment or pipeline activation. No files/downloads are auto-discovered.
CLIP_HYBRID_SEARCH_ENABLED=false
# With true, also provide CLIP_DATABASE_URL through its approved secret path and
# absolute existing interpreter/model paths. Preserve the venv interpreter path.
# CLIP_HYBRID_SEARCH_INTERPRETER=/absolute/project/.tools/semantic/venv/bin/python
# CLIP_HYBRID_SEARCH_MODEL_DIR=/absolute/project/.tools/semantic/model
# This does not start an embedding worker, backfill or mark a pipeline serving.

# Optional durable-job dispatcher; requires Hybrid enabled. Off by default.
# Processes only existing jobs; never registers/backfills/activates a pipeline.
CLIP_HYBRID_WORKER_ENABLED=false
