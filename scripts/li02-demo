#!/usr/bin/env python3
"""Start or stop the isolated LI-02 cloud demo with explicit plan gates.

The start command continues a saved partial run from its last recorded phase.

The command targets only account 335523638354 in ap-south-1. It uses fixed
Terraform/task definitions, records the shared RDS baseline locally without
credentials, and asks for the displayed plan hash before each Terraform apply.
"""

from __future__ import annotations

import argparse
import datetime as dt
import hashlib
import json
import os
import secrets
import shlex
import subprocess
import sys
import tempfile
